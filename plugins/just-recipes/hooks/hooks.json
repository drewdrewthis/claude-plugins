{
  "description": "Funnel raw Bash through just recipes where a justfile resolves",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/enforce-just.sh" }
        ]
      }
    ]
  }
}
